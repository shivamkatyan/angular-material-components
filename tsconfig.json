{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "paths": {
      "@katyan/*": ["dist/@katyan/*"],
      "@katyan/color-picker": ["dist/@katyan/color-picker"],
      "@katyan/color-picker/*": ["dist/@katyan/color-picker/*"],
      "@katyan/datetime-picker": ["dist/@katyan/datetime-picker"],
      "@katyan/datetime-picker/*": ["dist/@katyan/datetime-picker/*"],
      "file-input": ["dist/file-input"],
      "file-input/*": ["dist/file-input/*"]
    },
    "useDefineForClassFields": false
  }
}
